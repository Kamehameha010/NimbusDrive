{
    "name": "Backend",
    "image": "mcr.microsoft.com/devcontainers/python:dev-3.13-trixie",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
        "ghcr.io/jsburckhardt/devcontainer-features/ruff:1": {},
        "ghcr.io/devcontainers/features/go:1": {},
        "ghcr.io/devcontainers/features/terraform:1": {},
        "ghcr.io/devcontainers/features/aws-cli:1": {},
        "ghcr.io/jsburckhardt/devcontainer-features/opencode:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
            "moby": false,
            "azureDnsAutoDetection": false
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.pylance",
                "charliermarsh.ruff",
                "usernamehw.errorlens",
                "eamodio.gitlens",
                "ms-python.debugpy",
                "github.copilot",
                "github.copilot-chat",
                "dannysteenman.aws-terraform-extension-pack",
                "golang.go",
                "premparihar.gotestexplorer",
                "766b.go-outliner"
            ],
            "settings": {
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": false,
                "python.linting.ruffEnabled": true,
                "editor.formatOnSave": true,
                "files.autoSave": "afterDelay",
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "always",
                    "source.fixAll.ruff": "always",
                    "source.unusedImports": "always"
                }
            }
        }
    },
    "postCreateCommand": "chmod +x ./scripts/start-script.sh && ./scripts/start-script.sh",
    // "postStartCommand": "uv run --env-file .env uvicorn main:app --host 0.0.0.0 --reload",
    "hostRequirements": {
        "cpus": 2,
        "memory": "4gb",
        "storage": "4gb"
    },
    "forwardPorts": [
        8000
    ],
    "containerEnv": {
        "PROJECT_ENV": "dev"
    },
    "portsAttributes": {
        "8000": {
            "protocol": "http",
            "label": "Agent API"
        }
    }
}